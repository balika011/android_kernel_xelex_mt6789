#include "qx0_display.dtsi"

&odm {
	touch_ldo: fixed-regulator-1 {
		compatible = "regulator-fixed";
		regulator-name = "touch_ldo";
		gpio = <&pio 27 0>;
		enable-active-high;
		regulator-boot-on;
	};

	display_1v8_ldo: fixed-regulator-3 {
		compatible = "regulator-fixed";
		regulator-name = "display_1v8_ldo";
		gpio = <&pio 157 0>;
		enable-active-high;
		regulator-boot-on;
	};

	display_2v8_ldo: fixed-regulator-4 {
		compatible = "regulator-fixed";
		regulator-name = "display_2v8_ldo";
		gpio = <&pio 158 0>;
		enable-active-high;
		regulator-boot-on;
	};
};


&mtk_leds {
	compatible = "mediatek,pwm-leds";

	backlight {
		label = "lcd-backlight";
		max-brightness = <255>;
		max-hw-brightness = <1023>;
		led_mode = <5>;
		gate_enable = <0>;
		pwm_config = <0 1 0 0 0>;
		pwms = <&disp_pwm 0 39385>;
		pwm-names = "lcd-backlight";
	};
};

&dsi0 {
	panel1@0 {
		compatible = "jdi,panorama";
		v18-supply = <&display_1v8_ldo>;
		v28-supply = <&display_2v8_ldo>;
		touch-supply = <&touch_ldo>;
	};
};

&i2c0 {
	synaptics_dsx_i2c_display@67 {
		synaptics,reset-delay-ms = <60>;
		synaptics,reset-active-ms = <200>;
		synaptics,firmware = "passport_display.bin";
	};
};