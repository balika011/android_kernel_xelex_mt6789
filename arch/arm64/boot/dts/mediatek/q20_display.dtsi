#include "qx0_display.dtsi"

&odm {
	touch_ldo: fixed-regulator-1 {
		compatible = "regulator-fixed";
		regulator-name = "touch_ldo";
		gpio = <&pio 27 0>;
		enable-active-high;
		regulator-boot-on;
	};

	display_avdd_ldo: fixed-regulator-2 {
		compatible = "regulator-fixed";
		regulator-name = "display_1v8_ldo";
		gpio = <&pio 156 0>;
		enable-active-high;
		regulator-boot-on;
	};
};

&mtk_leds {
	compatible = "mediatek,i2c-leds";

	backlight {
		max-hw-brightness = <25>;
		led_mode = <6>;
		gate_enable = <0>;
		pwm_config = <0 1 0 0 0>;
	};
};

&dsi0 {
	panel1@0 {
		compatible = "innolux,pd035sc-01a";
		touch-supply = <&touch_ldo>;
		avdd-supply = <&display_avdd_ldo>;
	};
};

&i2c7 {
	i2c_lcd_bias_mtk:i2c_lcd_bias@3e {
		compatible = "mediatek,mtk-gateic-drv-ocp2131";
		reg = <0x3e>;
		id = <6>;
		gate-power-gpios = <&pio 84 0>;
		status = "okay";
	};
};

&i2c0 {
	synaptics_dsx_i2c_display@67 {
		synaptics,reset-delay-ms = <200>;
		synaptics,reset-active-ms = <20>;
	};
};