#include <dt-bindings/input/input.h>

&odm {
	leds {
		keyboard {
			label = "keyboard-backlight";
			gpios = <&pio 151 0>;
			default-state = "off";
			linux,default-trigger = "kbd-backlight";
		};
	};

	keypad_ldo: fixed-regulator-0 {
		compatible = "regulator-fixed";
		regulator-name = "keypad_ldo";
		gpio = <&pio 159 0>;
		enable-active-high;
	};
};

&i2c6 {
	synaptics_dsx_i2c_keypad@20 {
		compatible = "synaptics,dsx";
		reg = <0x20>;
		vdd-supply = <&keypad_ldo>;
		synaptics,pwr-reg-name = "vdd";
		synaptics,input-device-name = "touch_keypad";
		synaptics,irq-gpio = <&pio 12 0>;
		synaptics,irq-flags = <0x2008>;
		synaptics,reset-gpio = <&pio 31 0>;
		synaptics,reset-on-state = <0>;
		synaptics,reset-delay-ms = <63>;
		synaptics,reset-active-ms = <1>;
		synaptics,touchpad;
		synaptics,firmware = "passport_keyboard.bin";
		synaptics,flash-only-bricked;
	};
};

&i2c2 {
	status = "okay";
	keypad_gpio: aw95016_ex@20 {
		compatible = "awinic,aw95016a";
		reg = <0x20>;
		reset-gpio = <&pio 153 0>;
		interrupt-parent = <&pio>;
		interrupts = <4 IRQ_TYPE_EDGE_FALLING>;
		gpio-controller;
		interrupt-controller;
		#gpio-cells = <2>;
		#interrupt-cells = <2>;
		status = "okay";
	};
};

&odm {
	keypad {
		compatible = "gpio-matrix-keypad";
		row-gpios = <&keypad_gpio 4 0>,
			<&keypad_gpio 3 0>,
			<&keypad_gpio 2 0>,
			<&keypad_gpio 5 0>,
			<&keypad_gpio 6 0>,
			<&keypad_gpio 7 0>;
		column-gpios = <&keypad_gpio 8 0>,
			<&keypad_gpio 9 0>,
			<&keypad_gpio 10 0>,
			<&keypad_gpio 11 0>,
			<&keypad_gpio 12 0>;
		keypad,num-rows = <6>;
		keypad,num-columns = <5>;
		keypad,debounce-ms = <5>;
		linux,keypad-no-autorepeat;
		linux,keymap = <
				MATRIX_KEY(2, 0, KEY_Q)
				MATRIX_KEY(2, 1, KEY_W)
				MATRIX_KEY(2, 2, KEY_E)
				MATRIX_KEY(2, 3, KEY_R)
				MATRIX_KEY(2, 4, KEY_T)
				MATRIX_KEY(3, 0, KEY_Y)
				MATRIX_KEY(3, 1, KEY_U)
				MATRIX_KEY(3, 2, KEY_I)
				MATRIX_KEY(3, 3, KEY_O)
				MATRIX_KEY(3, 4, KEY_P)
				MATRIX_KEY(1, 0, KEY_A)
				MATRIX_KEY(1, 1, KEY_S)
				MATRIX_KEY(1, 2, KEY_D)
				MATRIX_KEY(1, 3, KEY_F)
				MATRIX_KEY(1, 4, KEY_G)
				MATRIX_KEY(4, 0, KEY_H)
				MATRIX_KEY(4, 1, KEY_J)
				MATRIX_KEY(4, 2, KEY_K)
				MATRIX_KEY(4, 3, KEY_L)
				MATRIX_KEY(4, 4, KEY_BACKSPACE)
				MATRIX_KEY(0, 0, KEY_Z)
				MATRIX_KEY(0, 1, KEY_X)
				MATRIX_KEY(0, 2, KEY_C)
				MATRIX_KEY(0, 3, KEY_V)
				MATRIX_KEY(0, 4, KEY_SPACE)
				MATRIX_KEY(5, 1, KEY_B)
				MATRIX_KEY(5, 2, KEY_N)
				MATRIX_KEY(5, 3, KEY_M)
				MATRIX_KEY(5, 4, KEY_ENTER)
			>;
	};
};