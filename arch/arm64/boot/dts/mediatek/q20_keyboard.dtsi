&odm {
	bbqX0kbd_vdd_ldo: fixed-regulator-2 {
		compatible = "regulator-fixed";
		regulator-name = "bbqX0kbd_vdd_ldo";
		gpio = <&pio 159 0>;
		enable-active-high;
	};

	bbqX0kbd_1v8_ldo: fixed-regulator-3 {
		compatible = "regulator-fixed";
		regulator-name = "bbqX0kbd_1v8_ldo";
		gpio = <&pio 157 0>;
		enable-active-high;
	};

	bbqX0kbd_2v8_ldo: fixed-regulator-4 {
		compatible = "regulator-fixed";
		regulator-name = "bbqX0kbd_2v8_ldo";
		gpio = <&pio 158 0>;
		enable-active-high;
	};
};

&i2c6 {
	bbqX0kbd@1f {
		compatible = "wallComputer,bbqX0kbd";
		reg = <0x1f>;
		interrupt-parent = <&pio>;
		interrupts = <12 IRQ_TYPE_EDGE_FALLING>;
		vdd-supply = <&bbqX0kbd_vdd_ldo>;
		1v8-supply = <&bbqX0kbd_1v8_ldo>;
		2v8-supply = <&bbqX0kbd_2v8_ldo>;
		firmware-download-gpios = <&pio 47 0>;
	};
};