/dts-v1/;
/plugin/;
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/mt6789-pinfunc.h>
#include <dt-bindings/usb/pd.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/iio/mt635x-auxadc.h>
#include "mediatek/cust_mt6789_camera.dtsi"

&mtk_leds {
	compatible = "mediatek,i2c-leds";

	backlight {
		max-hw-brightness = <25>;
		led_mode = <6>;
		gate_enable = <0>;
		pwm_config = <0 1 0 0 0>;
	};
};

&odm {
	leds {
		compatible = "gpio-leds";
		red {
			label = "red";
			gpios = <&pio 46 0>;
			default-state = "off";
			power_off_charge,label = "red1";
			linux,default-trigger = "battery_red";
			retain-state-suspended;
		};
		green {
			label = "green";
			gpios = <&pio 48 0>;
			default-state = "off";
			power_off_charge,label = "green1";
			linux,default-trigger = "battery_green";
			retain-state-suspended;
		};
		blue {
			label = "blue";
			gpios = <&pio 49 0>;
			default-state = "off";
			power_off_charge,label = "blue1";
			linux,default-trigger = "battery_blue";
			retain-state-suspended;
		};
	};

	display_ldo: fixed-regulator-1 {
		compatible = "regulator-fixed";
		regulator-name = "display_ldo";
		gpio = <&pio 27 0>;
		enable-active-high;
	};

	bbqX0kbd_vdd_ldo: fixed-regulator-2 {
		compatible = "regulator-fixed";
		regulator-name = "bbqX0kbd_vdd_ldo";
		gpio = <&pio 159 0>;
		enable-active-high;
	};

	bbqX0kbd_1v8_ldo: fixed-regulator-3 {
		compatible = "regulator-fixed";
		regulator-name = "bbqX0kbd_1v8_ldo";
		gpio = <&pio 157 0>;
		enable-active-high;
	};

	bbqX0kbd_2v8_ldo: fixed-regulator-4 {
		compatible = "regulator-fixed";
		regulator-name = "bbqX0kbd_2v8_ldo";
		gpio = <&pio 158 0>;
		enable-active-high;
	};
};

&pio {
	mtkfb_pins_lcm_led_en1: lcm_led_en1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO84__FUNC_GPIO84>;
			slew-rate = <1>;
			output-high;
		};
	};

	mtkfb_pins_lcm_led_en0: lcm_led_en0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO84__FUNC_GPIO84>;
			slew-rate = <1>;
			output-low;
		};
	};

	mtkfb_pins_lcm_rst_out1_gpio: lcm_rst_out1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO85__FUNC_GPIO85>;
			slew-rate = <1>;
			output-high;
		};
	};

	mtkfb_pins_lcm_rst_out0_gpio: lcm_rst_out0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO85__FUNC_GPIO85>;
			slew-rate = <1>;
			output-low;
		};
	};
	mtkfb_pins_lcm_dsi_te: lcm_dsi_te {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO83__FUNC_DSI_TE>;
		};
	};
};

&mtkfb {
	pinctrl-names = "lcm_led_en1_gpio", "lcm_led_en0_gpio",
		"lcm_rst_out1_gpio", "lcm_rst_out0_gpio",
		"mode_te_te";
	pinctrl-0 = <&mtkfb_pins_lcm_led_en1>;
	pinctrl-1 = <&mtkfb_pins_lcm_led_en0>;
	pinctrl-2 = <&mtkfb_pins_lcm_rst_out1_gpio>;
	pinctrl-3 = <&mtkfb_pins_lcm_rst_out0_gpio>;
	pinctrl-4 = <&mtkfb_pins_lcm_dsi_te>;
	status = "okay";
};

&dispsys_config {
	pinctrl-names =
		"lcm_rst_out1_gpio", "lcm_rst_out0_gpio",
		"mode_te_te";
	pinctrl-0 = <&mtkfb_pins_lcm_rst_out1_gpio>;
	pinctrl-1 = <&mtkfb_pins_lcm_rst_out0_gpio>;
	pinctrl-2 = <&mtkfb_pins_lcm_dsi_te>;
	status = "okay";
};

&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	
	panel1@0 {
		compatible = "mediatek,q20_panel_general,vdo";
		reg = <0>;
		reset-gpios = <&pio 85 0>;
		avdd-gpios  = <&pio 156 0>;
		board_name = "q20_v12";
		port {
			panel_in1: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
		
	};
	ports {
		port {
			dsi_out: endpoint {
				remote-endpoint = <&panel_in1>;
			};
		};
	};
};

&accdet {
	accdet-mic-vol = <6>;
	headset-mode-setting = <0x500 0x500 1 0x1f0 0x800 0x800 0x20 0x44>,
	                       < 0x0 0x0 0xe 0x0 0x0 0x0 0x0 0x0>;
	accdet-plugout-debounce = <1>;
	/*1:ACC mode, 2:low cost without in bias, 6:low cost with in bias*/
	accdet-mic-mode = <1>;
	/* eint_level_trigger: 8,LEVEL_LOW(DEF) ;4,LV_HIGH;others,LV_LOW */
	headset-eint-level-pol = <4>;
	/*0--MD_MAX--UP_MAX--DW_MAX*/
	headset-three-key-threshold = <0 80 220 400>;
	headset-three-key-threshold-CDD = <0 121 192 600>;
	/*0--MD_MAX--VOICE_MAX--UP_MAX--DW_MAX*/
	headset-four-key-threshold = <0 58 121 192 400>;
};

/* GPS GPIO standardization start */
&pio {
	gps_pins_default: gps_default {
	};
	gps_l1_lna_pins_ol: gps_l1_lna@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO25__FUNC_GPIO25>;
			output-low;
		};
	};
	gps_l1_lna_pins_dsp_ctrl: gps_l1_lna@1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO25__FUNC_GPS_L1_ELNA_EN>;
		};
	};
	gps_l1_lna_pins_oh: gps_l1_lna@2 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO25__FUNC_GPIO25>;
			output-high;
		};
	};
	gps_l5_lna_pins_ol: gps_l5_lna@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO87__FUNC_GPIO87>;
			output-low;
		};
	};
	gps_l5_lna_pins_dsp_ctrl: gps_l5_lna@1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO87__FUNC_GPS_L5_ELNA_EN>;
		};
	};
	gps_l5_lna_pins_oh: gps_l5_lna@2 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO87__FUNC_GPIO87>;
			output-high;
		};
	};
};

&gps {
	pinctrl-names = "default",
		"gps_l1_lna_disable",
		"gps_l1_lna_dsp_ctrl",
		"gps_l1_lna_enable",
		"gps_l5_lna_disable",
		"gps_l5_lna_dsp_ctrl",
		"gps_l5_lna_enable";
	pinctrl-0 = <&gps_pins_default>;
	pinctrl-1 = <&gps_l1_lna_pins_ol>;
	pinctrl-2 = <&gps_l1_lna_pins_dsp_ctrl>;
	pinctrl-3 = <&gps_l1_lna_pins_oh>;
	pinctrl-4 = <&gps_l5_lna_pins_ol>;
	pinctrl-5 = <&gps_l5_lna_pins_dsp_ctrl>;
	pinctrl-6 = <&gps_l5_lna_pins_oh>;
	status = "okay";
};
/* GPS GPIO standardization end */
#include "mediatek/cust_mt6789_camera_v4l2.dtsi"

&i2c6 {
	bbqX0kbd@1f {
		compatible = "wallComputer,bbqX0kbd";
		reg = <0x1f>;
		interrupt-parent = <&pio>;
		interrupts = <12 IRQ_TYPE_EDGE_FALLING>;
		vdd-supply = <&bbqX0kbd_vdd_ldo>;
		1v8-supply = <&bbqX0kbd_1v8_ldo>;
		2v8-supply = <&bbqX0kbd_2v8_ldo>;
		firmware-download-gpios = <&pio 47 0>;
	};
};

&i2c7 {
	i2c_lcd_bias_mtk:i2c_lcd_bias@3e {
		compatible = "mediatek,mtk-gateic-drv-ocp2131";
		reg = <0x3e>;
		id = <6>;
		gate-power-gpios = <&pio 84 0>;
		status = "okay";
	};
};

&pdc {
	pd_vbus_upper_bound = <12000000>;
};

&charger {
	charger = <&upm6922_chg>;
	algorithm_name = "Basic";
	disable_aicl;

	/* common */
	battery_cv = <4440000>;
	max_charger_voltage = <12000000>;
	min_charger_voltage = <4600000>;

	/* sw jeita */
	/* enable_vbat_mon = <1>; */
	/* enable_sw_jeita; */
	jeita_temp_above_t4_cv = <4240000>;
	jeita_temp_t3_to_t4_cv = <4240000>;
	jeita_temp_t2_to_t3_cv = <4340000>;
	jeita_temp_t1_to_t2_cv = <4240000>;
	jeita_temp_t0_to_t1_cv = <4040000>;
	jeita_temp_below_t0_cv = <4040000>;
	temp_t4_thres = <50>;
	temp_t4_thres_minus_x_degree = <47>;
	temp_t3_thres = <45>;
	temp_t3_thres_minus_x_degree = <39>;
	temp_t2_thres = <10>;
	temp_t2_thres_plus_x_degree = <16>;
	temp_t1_thres = <0>;
	temp_t1_thres_plus_x_degree = <6>;
	temp_t0_thres = <0>;
	temp_t0_thres_plus_x_degree = <0>;
	temp_neg_10_thres = <0>;

	/* battery temperature protection */
	enable_min_charge_temp;
	min_charge_temp = <(-5)>;
	min_charge_temp_plus_x_degree = <1>;
	max_charge_temp = <55>;
	max_charge_temp_minus_x_degree = <53>;

	/* charging current */
	usb_charger_current = <500000>;
	ac_charger_current = <3250000>;
	ac_charger_input_current = <3000000>;
	charging_host_charger_current = <3250000>;

	/* dynamic mivr */
	/* enable_dynamic_mivr;*/
	min_charger_voltage_1 = <4400000>;
	min_charger_voltage_2 = <4200000>;
	max_dmivr_charger_current = <1800000>;

	/* fast charging algo support indicator */
	/* enable_fast_charging_indicator; */
};

&pe5 {
	polling_interval = <10000>;
	ta_cv_ss_repeat_tmin = <25>;
	vbat_cv = <4440>;
	start_soc_min = <0>;
	start_soc_max = <80>;
	start_vbat_max = <4300>;
	idvchg_term = <500>;
	idvchg_step = <50>;
	ita_level = <3000 2500 2000 1500>;
	rcable_level = <250 300 375 500>;
	ita_level_dual = <5000 3700 3400 3000>;
	rcable_level_dual = <230 350 450 550>;
	idvchg_ss_init = <1000>;
	idvchg_ss_step = <250>;
	idvchg_ss_step1 = <100>;
	idvchg_ss_step2 = <50>;
	idvchg_ss_step1_vbat = <4000>;
	idvchg_ss_step2_vbat = <4200>;
	ta_blanking = <400>;
	swchg_aicr = <0>;
	swchg_ichg = <2000>;
	swchg_aicr_ss_init = <400>;
	swchg_aicr_ss_step = <200>;
	swchg_off_vbat = <4250>;
	force_ta_cv_vbat = <4400>;
	chg_time_max = <5400>;
	tta_level_def = <0 0 0 0 25 50 60 70 80>;
	tta_curlmt = <0 0 0 0 0 0 0 0 (-1)>;
	tta_recovery_area = <3>;
	tbat_level_def = <0 0 0 5 25 40 43 46 50>;
	tbat_curlmt = <(-1) (-1) (-1) (-1) (-1) (-1) (-1) (-1) (-1)>;
	tbat_recovery_area = <3>;
	tdvchg_level_def = <0 0 0 5 25 65 70 75 90>;
	tdvchg_curlmt = <(-1) (-1) (-1) (-1) (-1) (-1) (-1) (-1) (-1)>;
	tdvchg_recovery_area = <3>;
	tswchg_level_def = <0 0 0 5 25 65 70 75 80>;
	tswchg_curlmt = <(-1) (-1) (-1) (-1) (-1) (-1) (-1) (-1) (-1)>;
	tswchg_recovery_area = <3>;
	ifod_threshold = <200>;
	rsw_min = <20>;
	ircmp_rbat = <40>;
	ircmp_vclamp = <0>;
	vta_cap_min = <6800>;
	vta_cap_max = <11000>;
	ita_cap_min = <1000>;
	support_ta = "pca_ta_pps", "pd_adapter";
	allow_not_check_ta_status;
	vbat_threshold = <4250>;
};

&i2c0 {
	synaptics_dsx_i2c_display@67 {
		compatible = "synaptics,dsx";
		reg = <0x67>;
		vdd-supply = <&display_ldo>;
		synaptics,pwr-reg-name = "vdd";
		synaptics,input-device-name = "touch_display";
		synaptics,irq-gpio = <&pio 9 0>;
		synaptics,irq-flags = <0x2008>;
		synaptics,reset-gpio = <&pio 152 0>;
		synaptics,reset-on-state = <0>;
		synaptics,reset-delay-ms = <200>;
		synaptics,reset-active-ms = <20>;
	};
};

&mtk_gauge {
	charger = <&upm6922_chg>;
};

&mtk_ctd {
	bc12 = <&upm6922_chg>;
};

&extcon_usb {
	charger = <&upm6922_chg>;
	vbus-supply = <&upm6922_otg_vbus>;
	vbus-voltage = <0>;
	vbus-current = <0>;
};

&i2c3 {
	oca72xxx_pa@58 {
		compatible = "ocs,oca72xxx_pa";
		reg = <0x58>;
		dev_index = < 0 >;
		status = "okay";
	};

	st21nfc: st21nfc@08 {
		compatible = "st,st21nfc";
		reg = <0x08>;
		interrupt-parent = <&pio>;
		interrupts = <1 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&pio 150 0x00>;
		irq-gpios = <&pio 1 0x0>;
		clkreq-gpios = <&pio 68 0x00>;
		status = "ok";
	};	
};

&i2c5 {
	aw87xxx_pa@58 {
		compatible = "awinic,aw87xxx_pa";
		reg = <0x58>;
		dev_index = < 0 >;
		status = "okay";
	};

	upm6922_chg:upm6922@6B {
		status = "okay";
		compatible = "up,upm6922_charger";
		reg = <0x6b>;
		up,intr_gpio = <&pio 37 0>;

		up,upm6922,ichg = <3000>;              /* unit:1mA */
		up,upm6922,iprechg = <180>;            /* unit:1mA */
		up,upm6922,iterm = <200>;              /* unit:1mA */
		up,upm6922,vreg = <4440>;              /* unit:1mV */
		up,upm6922,vindpm = <4600>;            /* unit:1mV */
		up,upm6922,boostv = <5000>;            /* unit:1mV */
		up,upm6922,boosti = <1200>;            /* unit:1mA */
		up,upm6922,vac-ovp = <14000>;          /* unit:1mV */
		
		bc12_sel = <&mtk_ctd>;
		boot_mode = <&chosen>;
		phys = <&u2port0 PHY_TYPE_USB2>;
		phy-names = "usb2-phy";
		usb = <&usb>;
		gauge = <&mtk_gauge>;
		io-channels =
			<&pmic_auxadc AUXADC_VCDT>,
			<&pmic_auxadc AUXADC_BATADC>;
		io-channel-names =
			"pmic6366_vcdt",
			"pmic6366_batadc";
			
		upm6922_otg_vbus: otg {
			regulator-compatible = "upm6922,otg-vbus";
			regulator-name = "usb-otg-vbus";
		};
	};
	
	hupm6722-charger@65 {
		status = "okay";
		compatible = "unisemipower,upm6722-standalone";
		reg = <0x65>;
		upm6722,irq-gpio = <&pio 10 0>;

		upm6722,bat-ocp-disable;
		upm6722,tsbus-flt-disable;
		upm6722,tsbat-flt-disable;
		upm6722,wdt-disable;
		upm6722,vbus-errhi-disable;

		upm6722,bat-ovp-threshold = <4525>;			/* unit: 1mV */
		upm6722,bat-ocp-threshold = <8200>;			/* unit: 1mA */
		upm6722,bus-ovp-threshold = <12000>;		/* unit: 1mV */
		upm6722,bus-ocp-threshold = <5100>;			/* unit: 1mA */
		upm6722,bus-ucp-threshold = <250>;			/* unit: 1mA */
		upm6722,bus-rcp-threshold = <300>;			/* unit: 1mA */
		upm6722,vac1-ovp-threshold = <18000>;		/* unit: 1mV */
		upm6722,vac2-ovp-threshold = <18000>;		/* unit: 1mV */
		upm6722,vout-ovp-threshold = <5000>;		/* unit: 1mV */
		upm6722,tdie-flt-threshold = <140>;			/* unit: 1℃ */
		upm6722,tsbus-flt-threshold = <4102>;		/* unit: 0.001% */
		upm6722,tsbat-flt-threshold = <4102>;		/* unit: 0.001% */

		upm6722,bat-ocp-alm-disable;

		upm6722,bat-ovp-alm-threshold = <4510>;		/* unit: 1mV */
		upm6722,bat-ocp-alm-threshold = <8000>;		/* unit: 1mA */
		upm6722,bat-ucp-alm-threshold = <0>;		/* unit: 1mA */
		upm6722,bus-ovp-alm-threshold = <11800>;	/* unit: 1mV */
		upm6722,bus-ocp-alm-threshold = <5000>;		/* unit: 1mA */
		upm6722,tdie-alm-threshold = <125>;			/* unit: 1℃ */

		upm6722,sense-resistor-mohm = <5>;	/* unit: 1mohm */
		upm6722,ss-timeout = <10000>;		/* unit: 1ms */
		upm6722,wdt-set = <30000>;			/* unit: 1ms */
		upm6722,chg-config-1 = <1>;
		upm6722,fsw-set = <5>;				/*0:230K 1:310K 2:370K 3:460K 4:610K 5:970k*/
		upm6722,freq-shift = <0>;
		upm6722,ibus-ucp-fall-dg-sel = <0>;

		upm6722,adc-enable;
		upm6722,adc-rate = <0>;
		upm6722,adc-avg = <0>;
		upm6722,adc-avg-init = <0>;
		upm6722,adc-sample-bit = <0>;
	};
};

&i2c5 {
	upm7610@60 {
		compatible = "up,upm7610";
		reg = <0x60>;
		status = "okay";
		rt-tcpc,name = "type_c_port0"; /* tcpc_device's name */
		rt-tcpc,role_def = <5>; /* 0: Unknown, 1: SNK, 2: SRC */
					/* 3: DRP, 4: Try.SRC, 5: Try.SNK */
		rt-tcpc,rp_level = <0>; /* 0: Default, 1: 1.5, 2: 3.0 */
		rt-tcpc,vconn_supply  = <1>;  /* 0: Never, 1: Always, */
					      /* 2: EMarkOnly, 3: StartOnly */
		rt-tcpc,notifier_supply_num = <3>;
		upm7610pd,intr_gpio = <&pio 35 0x0>;
		upm7610pd,intr_gpio_num = <35>;
		pd-data {
			pd,vid = <0x362f>;
			pd,pid = <0x7610>;
			pd,source-cap-ext = <0x7610362f 0x00000000 0x00000000
					     0x00000000 0x00000000 0x02000000>;
			pd,mfrs = "UnisemipowerTCPC";

			/*
			 *	VSAFE5V = 0, MAX_POWER = 1, CUSTOM = 2,
			 *	MAX_POWER_LV = 0x21, MAX_POWER_LVIC = 0x31
			 *	MAX_POWER_HV = 0x41, MAX_POWER_HVIC = 0x51
			 */
			pd,charging_policy= <0x21>;

			/*
			 * Fixed 5V, 500 mA <0x00019032>
			 * Fixed 5V, 1A <0x00019064>
			 * Fixed 5V, 2A <0x000190c8>
			 * Fixed 5V, 3A <0x0001912c>
			 * Fixed 9V, 500 mA <0x0002d032>
			 * Fixed 9V, 1A <0x0002d064>
			 * Fixed 5V, 1.5A <0x00019096>
			 * Fixed 9V, 2A <0x0002d0c8>
			 * Fixed 9V, 3A <0x0002d12c>
			 * Fixed 12V, 2A <0x0003c0c8>
			 * Fixed 12V, 2.5A <0x0003c0fa>
			 * Fixed 12V, 3A <0x0003c12c>
			 * Variable 5-9V, 1A <0x8642d064>
			 * Variable 5-9V, 2A <0x8642d0c8>
			 * Variable 5-9V, 3A <0x8642d12c>
			 * PPS 3V~5.9V, 3A <0xc0761e3c>
			 * PPS 3V~11V, 3A  <0xc0dc1e3c>
			 * PPS 3V~11V, 3.25A  <0xc0dc1e41>
			 * PPS 3.3V~11V, 3A  <0xc0dc213c>
			 * PPS 5V~11V, 3.25A <0xc0dc3241>
			 * PPS 5V~20V, 3.25A <0xc1903241>
			 */

			pd,source-pdo-size = <1>;
			pd,source-pdo-data = <0x00019032>;
			/* 5V, 500 mA */
			
			pd,sink-pdo-size = <6>;
			pd,sink-pdo-data = <0x000190c8 0x0001912c 0x0002d0c8 0x0002d12c 0xc0dc213c 0xc1903241>;
			/* 0x0002d0c8 : 9V, 2A<0x04019032 0x04019064> */

			/*
			 * No DP, host + device
			 *	pd,id-vdo-size = <3>;
			 *	pd,id-vdo-data =
					<0xd00029cf 0x0 0x00010000>;
			 * With DP
			 *	pd,id-vdo-size = <4>;
			 *	pd,id-vdo-data =
			 *	<0xec0029cf 0x0 0x00010000 0x11000001>;
			 */
			 
			pd,id-vdo-size = <4>;
			pd,id-vdo-data = <0xec0029cf 0x0 0x00010000 0x11000001>;

			bat,nr = <1>;
			pd,country_nr = <0>;

			bat-info0 {
				bat,vid = <0x362f>;
				bat,pid = <0x7610>;
				bat,mfrs = "bat1";
				bat,design_cap = <3000>;
			};
		};
		dpm_caps {
			local_dr_power;
			local_dr_data;
			local_usb_comm;
			local_no_suspend;
			local_vconn_supply;

			attempt_enter_dp_mode;
			attempt_discover_cable;
			attempt_discover_id;

			/* 0: disable, 1: prefer_snk, 2: prefer_src */
			pr_check = <0>;

			/* 0: disable, 1: prefer_ufp, 2: prefer_dfp */
			dr_check = <0>;
		};
		displayport {
			/* connection type = "both", "ufp_d", "dfp_d" */
			1st_connection = "dfp_d";
			2nd_connection = "dfp_d";
			signal,dp_v13;
			typec,receptacle;
			ufp_d {
			};
			dfp_d {
				pin_assignment,mode_c;
				pin_assignment,mode_d;
				pin_assignment,mode_e;
			};
		};
	};
};

&kd_camera_hw1 {
	cam0_enable_sensor = "s5kjn1_mipi_raw";
	cam1_enable_sensor = "imx111_mipi_raw";
};

&i2c7 {
	mtk_camera_eeprom0: camera_eeprom0@50 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x50>;
		status = "okay";
	};
};

#include "q20_v12_factory/cust.dtsi"
